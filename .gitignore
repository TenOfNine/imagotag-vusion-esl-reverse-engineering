# --- Captures -----------------------------------------------------------
# Raw CSV exports grow to several hundred MB and are reproducible from
# the .sr files.
captures/*.csv
captures/*.vcd
captures/*.bin

# Large sigrok sessions. Add small ones (< 20 MB) explicitly with
#   git add -f captures/<file>.sr
captures/*.sr
!captures/README.md

# --- Analysis results -------------------------------------------------
# The reports SHOULD go into the repo - they are the actual result.
!analysis/out/*_transactions.txt
!analysis/out/*_init_sequence.py
!analysis/out/*_blocks.csv

# --- Firmware-Images -------------------------------------------------------
# Read-out original firmware does not belong in a public repo.
*.s37
*.hex
*.elf
*.bin.orig
firmware/**/dump*

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# --- Build -----------------------------------------------------------------
.pio/
build/
dist/

# --- Editor / OS -----------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
